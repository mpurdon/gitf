# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
gitf-*.tar

# Compiled escript binary (built via "mix escript.build").
/gitf

# Runtime log file.
section.log

# Local data/config directories.
.hive/
.gitf/

# Obsidian vault — runtime projection of the Archive (per the knowledge
# engine design the default root is <gitf_path>/vault/). Generated, not source.
/vault/

# macOS Finder metadata.
.DS_Store

# MCP client config (local to each machine).
.mcp.json

# Claude Code local config.
.claude/
hive
hive.log

# Build artifacts + crash/debug output (added during hardening)
crash_output*.log
*.escript
erl_crash.dump

# Terraform local state (infra/aws)
infra/aws/.terraform/
infra/aws/*.tfstate*
infra/aws/lambda/wake.zip
