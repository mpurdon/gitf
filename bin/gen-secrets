#!/usr/bin/env bash
# Generates the secrets block for /etc/gitf/gitf.env.
#
# Usage:
#   bin/gen-secrets                # print to stdout
#   bin/gen-secrets /etc/gitf/gitf.env   # append any MISSING secrets in place
set -euo pipefail

gen() { openssl rand -base64 48 | tr -d '\n='; }

SECRETS=(SECRET_KEY_BASE LIVE_VIEW_SIGNING_SALT SESSION_SIGNING_SALT RELEASE_COOKIE GITF_API_KEY)

if [[ $# -eq 0 ]]; then
  for name in "${SECRETS[@]}"; do
    echo "${name}=$(gen)"
  done
  exit 0
fi

ENV_FILE="$1"
touch "$ENV_FILE"
chmod 0600 "$ENV_FILE"

for name in "${SECRETS[@]}"; do
  # Append only when the variable has no non-empty assignment in the file.
  if grep -Eq "^${name}=.+" "$ENV_FILE"; then
    echo "skip: ${name} already set"
  else
    echo "${name}=$(gen)" >>"$ENV_FILE"
    echo "generated: ${name}"
  fi
done
