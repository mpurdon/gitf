#!/bin/sh
# MCP client for gitf.
#
# Remote mode (GITF_SERVER set, or [server] url in ~/.config/gitf/config.toml):
#   runs `gitf mcp-serve`, which boots as a thin client and proxies JSON-RPC
#   to the remote daemon's /api/v1/mcp bridge — the escript resolves the url
#   and api_key from config itself; this wrapper only picks the branch.
# Local mode: connects to the local daemon's Unix socket (thin client).

# Same path GiTF.global_config_dir/0 uses (it does not honor XDG_CONFIG_HOME,
# so neither do we — the two readers must agree on the file).
CONFIG="$HOME/.config/gitf/config.toml"

remote_configured() {
  [ -n "$GITF_SERVER" ] && return 0
  [ -f "$CONFIG" ] || return 1
  # True if a non-empty url line appears inside the [server] section.
  awk '/^\[/{in_server = ($0 == "[server]")} in_server && /^[[:space:]]*url[[:space:]]*=[[:space:]]*"..*"/{found=1} END{exit !found}' "$CONFIG"
}

if remote_configured; then
  # Filter boot-time log noise from stdout, passing only JSON-RPC lines.
  exec gitf mcp-serve 2>/dev/null | grep --line-buffered '^{'
fi

# -- Local mode: Unix socket thin client -------------------------------------
# Checks PID file to detect stale sockets immediately.
# Retries for up to 15 seconds if the daemon is still starting.

SOCK="${GITF_MCP_SOCK:-$HOME/.config/gitf/mcp.sock}"
PIDFILE="${SOCK}.pid"
RETRIES=30

# If socket exists but PID file shows a dead process, remove stale socket
if [ -S "$SOCK" ] && [ -f "$PIDFILE" ]; then
  OLD_PID=$(cat "$PIDFILE" 2>/dev/null)
  if [ -n "$OLD_PID" ] && ! kill -0 "$OLD_PID" 2>/dev/null; then
    rm -f "$SOCK" "$PIDFILE"
  fi
fi

i=0
while [ $i -lt $RETRIES ]; do
  if [ -S "$SOCK" ]; then
    exec nc -U "$SOCK"
  fi
  sleep 0.5
  i=$((i + 1))
done

echo '{"jsonrpc":"2.0","id":1,"error":{"code":-32000,"message":"gitf daemon not running. Start it with: gitf daemon"}}' >&2
exit 1
