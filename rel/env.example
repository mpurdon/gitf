# GiTF daemon environment — copy to /etc/gitf/gitf.env and fill in.
#   sudo install -m 0600 -o root -g root rel/env.example /etc/gitf/gitf.env
# `bin/gen-secrets` generates the secrets block below.

# -- Required secrets (release refuses to boot without the first three) -------
# Generated by `bin/gen-secrets /etc/gitf/gitf.env` — it appends any of these
# five that are missing. Uncomment and set manually only to pin a value.
#SECRET_KEY_BASE=
#LIVE_VIEW_SIGNING_SALT=
#SESSION_SIGNING_SALT=
# Stable Erlang distribution cookie (unset = random per boot, which breaks
# `bin/gitf remote` and any future clustering).
#RELEASE_COOKIE=
# Shared key for the HTTP API + remote CLI (`gitf login`). Optional but
# strongly recommended; without it only local_ip_bypass'd requests work.
#GITF_API_KEY=

# -- Network ------------------------------------------------------------------
GITF_PORT=4000
# Loopback only: Tailscale serve (or another reverse proxy) fronts the
# dashboard. Do not bind 0.0.0.0 on a box with any public exposure.
GITF_HOST=127.0.0.1
# Comma-separated allowed origins for LiveView websockets, e.g. the
# tailscale serve hostname: https://gitf.<tailnet>.ts.net
#GITF_CHECK_ORIGIN=

# -- Operational policy -------------------------------------------------------
# Server deployments should refuse to run AI-authored commands unsandboxed.
GITF_SANDBOX_REQUIRED=1
# Keep stdout logging (journalctl); this is also the default under a release.
GITF_LOG_STDOUT=1
# Structured logs for journald/CloudWatch consumers. Comment out for text.
GITF_LOG_FORMAT=json
#LOG_LEVEL=info

# -- Provider API keys --------------------------------------------------------
# On AWS, prefer Bedrock via the instance IAM role (no key needed) and store
# these in SSM Parameter Store, rendered here at boot by fetch-secrets.
#GEMINI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# -- Webhooks -----------------------------------------------------------------
#GITF_GITHUB_WEBHOOK_SECRET=
#GITF_SENTRY_WEBHOOK_SECRET=

# -- Idle-stop / backups (consumed by gitf-idle-stop / gitf-backup timers) ----
# Minutes of continuous idleness (no ghosts, no active missions) before the
# instance powers off. Empty or 0 disables.
GITF_IDLE_STOP_MINUTES=30
# Grace period after boot before idle-stop may fire.
GITF_IDLE_STOP_GRACE_MINUTES=15
# S3 bucket for store backups (created by the Terraform in infra/).
#GITF_BACKUP_BUCKET=
