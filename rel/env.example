# GiTF daemon environment — copy to /etc/gitf/gitf.env and fill in.
#   sudo install -m 0600 -o root -g root rel/env.example /etc/gitf/gitf.env
# `bin/gen-secrets` generates the secrets block below.

# -- Required secrets (release refuses to boot without the first three) -------
# Generated by `bin/gen-secrets /etc/gitf/gitf.env` — it appends any of these
# five that are missing. Uncomment and set manually only to pin a value.
#SECRET_KEY_BASE=
#LIVE_VIEW_SIGNING_SALT=
#SESSION_SIGNING_SALT=
# Stable Erlang distribution cookie (unset = random per boot, which breaks
# `bin/gitf remote` and any future clustering).
#RELEASE_COOKIE=
# Shared key for the HTTP API + remote CLI (`gitf login`). Optional but
# strongly recommended; without it only local_ip_bypass'd requests work.
#GITF_API_KEY=

# -- Network ------------------------------------------------------------------
GITF_PORT=4000
# Loopback only: Tailscale serve (or another reverse proxy) fronts the
# dashboard. Do not bind 0.0.0.0 on a box with any public exposure.
GITF_HOST=127.0.0.1
# EXTRA allowed origins for LiveView websockets, comma-separated, e.g. the
# tailscale serve hostname: https://gitf.<tailnet>.ts.net. The box's own
# `[server] url` is always allowed; "false" disables the check entirely.
#GITF_CHECK_ORIGIN=

# -- Operational policy -------------------------------------------------------
# Server deployments should refuse to run AI-authored commands unsandboxed.
GITF_SANDBOX_REQUIRED=1
# Keep stdout logging (journalctl); this is also the default under a release.
GITF_LOG_STDOUT=1
# Structured logs for journald/CloudWatch consumers. Comment out for text.
GITF_LOG_FORMAT=json
#LOG_LEVEL=info

# -- Secrets: prefer SSM Parameter Store over this file -----------------------
# GiTF.Secrets reads GITHUB_TOKEN, the two webhook secrets and the System One
# key from /gitf/<name> in Parameter Store when they are not set here. Leaving
# them unset here is the better choice on the box: nothing lands on the root
# volume (an AMI or snapshot carries this file's contents), CloudTrail records
# every read, and rotation is a parameter change plus
# `GiTF.Secrets.expire/1` — no restart, so nothing in flight is lost. A value
# set here WINS, which is the emergency override and also the thing to check
# when a parameter change appears to do nothing: `health_check` reports
# env/ssm/absent per secret.
#
# Provider API keys are deliberately NOT resolvable from Parameter Store — a
# resident key flips in-process consumers off the subscription onto a metered
# API, so its presence stays a deliberate local act. See GiTF.Secrets.
#GEMINI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# TypeSafe System One (Jev) — calibrated typed decisions, see GiTF.SystemOne.
# Prefer /gitf/system_one_api_key in Parameter Store. A key alone spends
# nothing: GITF_SYSTEM_ONE_ENABLED must also be true.
#GITF_SYSTEM_ONE_API_KEY=

# -- Webhooks -----------------------------------------------------------------
#GITF_GITHUB_WEBHOOK_SECRET=
#GITF_SENTRY_WEBHOOK_SECRET=

# -- Idle-stop / backups (consumed by gitf-idle-stop / gitf-backup timers) ----
# Minutes of continuous idleness (no ghosts, no active missions) before the
# instance powers off. Empty or 0 disables.
GITF_IDLE_STOP_MINUTES=30
# Grace period after boot before idle-stop may fire.
GITF_IDLE_STOP_GRACE_MINUTES=15
# Raise idle_stop_imminent this many minutes before the box powers off
# (the operator's last chance to hold it; Discord renders it with buttons).
#GITF_IDLE_STOP_WARN_MINUTES=10

# -- Discord (docs/plans/discord.md) -----------------------------------------
# A FACTORY relays alerts to the Cabinet's bot (signed with
# GITF_GITHUB_WEBHOOK_SECRET); the Cabinet posts them.
#GITF_DISCORD_RELAY_URL=https://gitf-cabinet.tailcf2c46.ts.net:8443/relay/<slug>
# Fallback used only when the relay fails: a Discord incoming-webhook URL.
#DISCORD_WEBHOOK_URL=
# The CABINET runs the bot. Token by value here (never in config.toml).
#DISCORD_BOT_TOKEN=
#GITF_DISCORD_GUILD_ID=
# Discord user ids allowed to press buttons; empty = the guild owner only.
#GITF_DISCORD_OPERATORS=
# S3 bucket for store backups (created by the Terraform in infra/).
#GITF_BACKUP_BUCKET=
