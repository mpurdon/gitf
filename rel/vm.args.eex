## Tune process/port limits and enable kernel poll for factory-scale BEAM.
+P 1000000
+Q 1000000
+K true

## Crash dump location — override via ERL_CRASH_DUMP env at runtime.
## -env ERL_CRASH_DUMP /tmp/erl_crash.dump

## Cookie and node name are provided at runtime via env.sh (RELEASE_COOKIE
## / RELEASE_NODE). Production deployments MUST set RELEASE_COOKIE to a
## stable secret — otherwise OTP generates a random cookie on each boot
## and distributed Erlang connections will fail.
-setcookie ${RELEASE_COOKIE}
-name ${RELEASE_NODE}
